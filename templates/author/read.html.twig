{# Display Flash Messages #}
{% for message in app.flashes('success') %}
    <div class="alert alert-success" id="flash-message">
        {{ message }}
    </div>
{% endfor %}

<table border="1">
    <tr>
        <th>Id</th>
        <th>Username</th>
        <th>Email</th>
        <th>Action</th>


    </tr>

    {% for author in authors %}
        <tr>
            <td>{{ author.id }}</td>
            <td>{{ author.username }}</td>
            <td>{{ author.email }}</td>
            <td><a href="{{ path('app_delete', {'id': author.id}) }}">Delete</a></td>
            <td><a href="{{ path('update', {'id': author.id}) }}">Update</a></td>
        </tr>
    {% endfor %}


</table>
            <td><a href="{{ path('app_ajout') }}"> ajout </a></td>

{# JavaScript to remove flash message after 5 seconds #}
<script>
    setTimeout(function() {
        var flashMessage = document.getElementById('flash-message');
        if (flashMessage) {
            flashMessage.style.display = 'none';
        }
    }, 2000); // 2000ms = 2 seconds
</script>

